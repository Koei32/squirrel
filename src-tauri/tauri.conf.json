{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "squirrel",
	"version": "0.3.0",
	"identifier": "com.koei.squirrel",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Squirrel",
				"width": 400,
				"minWidth": 200,
				"visible": false,
				"height": 500,
				"minHeight": 300,
				"center": true,
				"decorations": false,
				"shadow": false,
				"resizable": true,
				"fullscreen": false,
				"devtools": false,
				"scrollBarStyle": "default"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
